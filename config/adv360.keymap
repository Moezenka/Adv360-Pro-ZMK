#include <dt-bindings/zmk/stp.h>
#include "keys_se.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        morph_left_paren_curly: morph_left_paren_curly {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_LEFT_PAREN_CURLY";
            bindings = <&kp SE_LEFT_BRACE>, <&kp SE_LEFT_PARENTHESIS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        morph_right_paren_curly: morph_right_paren_curly {
            compatible = "zmk,behavior-mod-morph";
            label = "MORPH_RIGHT_PAREN_CURLY";
            bindings = <&kp SE_RIGHT_BRACE>, <&kp SE_RIGHT_PARENTHESIS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1           &kp N2       &kp N3    &kp N4     &kp N5  &tog 4                                                                  &mo 6                     &kp N6  &kp N7  &kp N8        &kp N9      &kp NUMBER_0  &kp SE_PLUS
&kp TAB    &kp Q            &kp W        &kp E     &kp R      &kp T   &morph_left_paren_curly                                                 &morph_right_paren_curly  &kp Y   &kp U   &kp I         &kp O       &kp P         &kp LBKT
&kp ESC    &kp A            &kp S        &kp D     &kp F      &kp G   &none                    &kp LCTRL  &kp RALT      &kp LGUI   &kp RALT   &none                     &kp H   &kp J   &kp K         &kp L       &kp SEMI      &kp SQT
&kp LSHFT  &kp Z            &kp X        &kp C     &kp V      &kp B                                       &kp HOME      &kp PG_UP                                       &kp N   &kp M   &kp SE_COMMA  &kp SE_DOT  &kp SE_MINUS  &kp RSHFT
&kp LCTRL  &kp NON_US_BSLH  &kp SE_PIPE  &kp LEFT  &kp RIGHT          &kp BSPC                 &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE                         &kp UP  &kp DOWN      &kp NUHS    &kp SE_CARET  &mo 5
            >;
        };

        us-qwerty {
            display-name = "us";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 4                                                   &mo 6      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 5      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 5
            >;
        };

        colemak {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp Q   &kp W   &kp F   &kp P   &kp G   &trans                                      &trans  &kp J   &kp L   &kp U   &kp Y   &trans  &trans
&trans  &kp A   &kp R   &kp S   &kp T   &kp D   &trans  &trans  &trans      &trans  &trans  &trans  &kp H   &kp N   &kp E   &kp I   &kp O   &trans
&trans  &kp Z   &kp X   &kp C   &kp V   &kp B                   &trans      &trans                  &kp K   &kp M   &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        canary {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp W   &kp L   &kp Y   &kp P   &kp B   &trans                                      &trans  &kp Z   &kp F   &kp O   &kp U   &trans  &trans
&trans  &kp C   &kp R   &kp S   &kp T   &kp G   &trans  &trans  &trans      &trans  &trans  &trans  &kp M   &kp N   &kp E   &kp I   &kp A   &trans
&trans  &kp Q   &kp J   &kp V   &kp D   &kp K                   &trans      &trans                  &kp X   &kp H   &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 6      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 5      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 5
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1        &kp F2  &kp F3  &kp F4      &kp F5  &kp F6  &tog 4                                                   &mo 6   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans        &trans  &trans  &trans      &trans  &trans  &kp C_VOLUME_UP                                          &to 0   &to 2   &trans  &trans  &trans   &trans   &trans
&kp CAPSLOCK  &trans  &trans  &trans      &trans  &trans  &kp C_VOL_DN         &trans  &trans      &trans  &trans  &to 1   &to 3   &trans  &trans  &trans   &trans   &trans
&trans        &trans  &trans  &kp K_CALC  &trans  &trans                               &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans        &trans  &trans  &trans      &trans          &kp LC(PRINTSCREEN)  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
